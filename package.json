{
  "name": "teaboom-product-card",
  "version": "1.0.0",
  "private": true,
  "description": "Карточка товара «Ананасовый улун»",
  "scripts": {
    "build": "sass scss/main.scss css/main.css --no-source-map --style=expanded",
    "watch": "sass scss/main.scss css/main.css --watch",
    "start": "serve .",
    "lint": "npm run lint:styles && npm run lint:scripts",
    "lint:styles": "stylelint \"scss/**/*.scss\"",
    "lint:scripts": "eslint js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "sass": "^1.80.0",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
